{
  "name": "@dryan/pedantry",
  "version": "2.0.4",
  "description": "Opinionated linting and formatting configs (ESLint, TypeScript, Prettier, Stylelint) and the pedantry CLI that syncs the rest",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:py",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:py:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"**/*.css\" --fix --allow-empty-input",
    "lint:py": "ruff check . && ruff format --check .",
    "lint:py:fix": "ruff check --fix . && ruff format .",
    "format": "prettier --write .",
    "setup": "lefthook install",
    "test": "node --test tests/npm-consumer/consumer.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "prettier",
    "stylelint",
    "ruff",
    "linting",
    "formatting",
    "typescript",
    "web-components",
    "lit"
  ],
  "license": "ISC",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "*",
    "@rollup/plugin-commonjs": ">=25",
    "@rollup/plugin-node-resolve": ">=15",
    "@rollup/plugin-terser": ">=0.4",
    "@rollup/plugin-typescript": ">=11",
    "@types/node": "*",
    "@vitest/coverage-v8": "*",
    "@vitest/ui": "*",
    "@web/test-runner": ">=0.18",
    "@web/test-runner-commands": "*",
    "@web/test-runner-playwright": ">=0.11",
    "eslint": "^10.13.0",
    "lit": "*",
    "prettier": ">=3",
    "rollup": ">=4",
    "rollup-plugin-summary": ">=2",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "repository": "github:dryan-org/pedantry",
  "exports": {
    "./eslint": {
      "types": "./src/pedantry/data/js/eslint.d.ts",
      "default": "./src/pedantry/data/js/eslint.js"
    },
    "./tsconfig": "./src/pedantry/data/js/tsconfig.base.json",
    "./prettier": {
      "types": "./src/pedantry/data/js/prettier.d.ts",
      "require": "./src/pedantry/data/js/prettier.cjs",
      "default": "./src/pedantry/data/js/prettier.js"
    },
    "./stylelint": {
      "types": "./src/pedantry/data/js/stylelint.d.ts",
      "default": "./src/pedantry/data/js/stylelint.js"
    },
    "./vitest": {
      "types": "./src/pedantry/data/js/vitest.d.ts",
      "default": "./src/pedantry/data/js/vitest.js"
    },
    "./rollup": {
      "types": "./src/pedantry/data/js/rollup.d.ts",
      "default": "./src/pedantry/data/js/rollup.js"
    },
    "./web-test-runner": {
      "types": "./src/pedantry/data/js/web-test-runner.d.ts",
      "default": "./src/pedantry/data/js/web-test-runner.js"
    },
    "./custom-elements-manifest": {
      "types": "./src/pedantry/data/js/custom-elements-manifest.d.ts",
      "default": "./src/pedantry/data/js/custom-elements-manifest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/pedantry/data/js"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {
    "eslint": "^10",
    "stylelint": "^17"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  }
}
